@page
@model PersonalFinance.Web.Pages.BudgetsModel
@{
    ViewData["Title"] = "Budgets";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">MONTHLY PLAN</p>
        <h1>Budgets</h1>
        <p class="text-muted mb-0">Set spending limits for @Model.MonthLabel. Category totals include every payment type.</p>
    </div>
</div>

<section class="card app-card mb-4">
    <div class="card-body">
        <div class="section-heading mb-3">
            <div><h2 class="h5 mb-1">By payment type</h2><p class="text-muted mb-0">Each limit is tracked separately for the month.</p></div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Payment type</th><th>Spent</th><th>Limit</th><th>Remaining</th><th class="budget-actions">Set limit (MXN)</th></tr></thead>
                <tbody>
                @foreach (var budget in Model.PaymentBudgets)
                {
                    <tr>
                        <td class="fw-semibold">@budget.PaymentType.ToDisplayName()</td>
                        <td>@budget.SpentLabel</td>
                        <td>@budget.LimitLabel</td>
                        <td class="@(budget.IsOver ? "text-danger fw-semibold" : "")">@budget.RemainingLabel</td>
                        <td>
                            <form method="post" asp-page-handler="SavePaymentLimit" class="budget-inline-form">
                                <input type="hidden" name="PaymentLimitForm.PaymentType" value="@budget.PaymentType" />
                                <input class="form-control form-control-sm" type="number" name="PaymentLimitForm.Amount" min="0.01" step="0.01" value="@(budget.LimitInCentavos is { } limit ? (limit / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" aria-label="@budget.PaymentType.ToDisplayName() monthly limit in MXN" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="form-text mt-2 mb-0">Leave a limit blank and save to remove it for this month.</p>
    </div>
</section>

<section class="card app-card">
    <div class="card-body">
        <div class="section-heading mb-3">
            <div><h2 class="h5 mb-1">By category</h2><p class="text-muted mb-0">These budgets combine cash, cards, and vouchers.</p></div>
        </div>
        <form method="post" asp-page-handler="SaveCategoryBudget" class="row g-2 align-items-end budget-create-form mb-4">
            <div class="col-md-5">
                <label asp-for="CategoryBudgetForm.CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryBudgetForm.CategoryId" class="form-select">
                    <option value="">Choose a category</option>
                    @foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }
                </select>
                <span asp-validation-for="CategoryBudgetForm.CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryBudgetForm.Amount" class="form-label">Monthly limit (MXN)</label>
                <input asp-for="CategoryBudgetForm.Amount" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="CategoryBudgetForm.Amount" class="text-danger"></span>
            </div>
            <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Save category budget</button></div>
        </form>
        @if (Model.CategoryBudgets.Count == 0)
        {
            <p class="text-muted mb-0">No category budgets set for this month.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Category</th><th>Spent</th><th>Limit</th><th>Remaining</th><th>Used</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var budget in Model.CategoryBudgets)
                    {
                        var progress = Math.Min(budget.UsagePercent, 100m);
                        <tr>
                            <td class="fw-semibold">@budget.Name</td><td>@budget.SpentLabel</td><td>@budget.LimitLabel</td>
                            <td class="@(budget.IsOver ? "text-danger fw-semibold" : "")">@budget.RemainingLabel</td>
                            <td class="budget-progress-cell">
                                <div class="progress" role="progressbar" aria-label="@budget.Name budget usage" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar @(budget.IsOver ? "bg-danger" : "bg-success")" style="width: @progress.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <small class="text-muted">@budget.UsagePercent.ToString("0.#")%</small>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="DeleteCategoryBudget" onsubmit="return confirm('Remove this category budget for the month?')">
                                    <input type="hidden" name="id" value="@budget.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<div class="alert alert-info mt-4 mb-0" role="status">
    Threshold crossings are recorded at 85% and 100% once per budget each month. Outlook delivery will be connected in Phase 8.
</div>
