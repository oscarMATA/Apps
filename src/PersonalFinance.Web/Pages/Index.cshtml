@page
@model IndexModel
@{
    ViewData["Title"] = "Overview";
}

<div class="dashboard-heading">
    <div>
        <p class="eyebrow">PERSONAL FINANCE</p>
        <h1>Overview</h1>
        <p class="text-muted mb-0">Your spending for @Model.MonthLabel</p>
    </div>
    <a asp-page="/Expenses" class="btn btn-primary btn-lg">＋ Add expense</a>
</div>

<section class="summary-card mb-4">
    <div>
        <p class="summary-label">Spent this month</p>
        <p class="summary-total">@Model.MonthTotalLabel</p>
        <p class="summary-note">@Model.ExpenseCount expense@(Model.ExpenseCount == 1 ? "" : "s") recorded</p>
    </div>
    <div class="summary-mark" aria-hidden="true">$</div>
</section>

<div class="dashboard-grid mb-4">
    <section class="card app-card">
        <div class="card-body">
            <div class="section-heading"><h2 class="h5">By payment type</h2><span class="text-muted">This month</span></div>
            <ul class="metric-list">
                @foreach (var total in Model.PaymentTypeTotals)
                {
                    <li><span>@total.Name</span><strong>@total.AmountLabel</strong></li>
                }
            </ul>
        </div>
    </section>
    <section class="card app-card">
        <div class="card-body">
            <div class="section-heading"><h2 class="h5">By category</h2><a asp-page="/Categories">Manage</a></div>
            @if (Model.CategoryTotals.Count == 0)
            {
                <p class="text-muted mb-0">Add an expense to see category totals.</p>
            }
            else
            {
                <ul class="metric-list">
                    @foreach (var total in Model.CategoryTotals)
                    {
                        <li><span>@total.Name</span><strong>@total.AmountLabel</strong></li>
                    }
                </ul>
            }
        </div>
    </section>
</div>

<section class="card app-card">
    <div class="card-body">
        <div class="section-heading"><h2 class="h5">Recent expenses</h2><a asp-page="/Expenses">View history</a></div>
        @if (Model.RecentExpenses.Count == 0)
        {
            <div class="empty-state">
                <p class="mb-1">No expenses recorded yet.</p>
                <a asp-page="/Expenses">Record your first expense</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Type</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                    @foreach (var expense in Model.RecentExpenses)
                    {
                        <tr>
                            <td>@expense.DateLabel</td><td>@expense.Description</td><td>@expense.CategoryName</td>
                            <td>@expense.PaymentType.ToDisplayName()</td><td class="text-end text-nowrap">@expense.AmountLabel</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
