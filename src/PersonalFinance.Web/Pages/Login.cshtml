@page
@model PersonalFinance.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>
@if (Model.SetupComplete)
{
    <p class="text-success">Password saved. You can now sign in.</p>
}
@if (Model.PasswordChanged)
{
    <p class="text-success">Password changed. Sign in again with your new password.</p>
}
<form method="post" class="auth-form">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" autofocus />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
